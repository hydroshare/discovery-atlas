:80 {
    redir /{{ .VITE_APP_BASE }} /{{ .VITE_APP_BASE }}/ 308
    # Handle the base path
    handle /{{ .VITE_APP_BASE }}* {
        root * /srv/discover-frontend
        try_files {path} /index.html
        file_server
    }
    
    # Redirect root to base path
    redir / /{{ .VITE_APP_BASE }}
    
    # Enable gzip
    encode gzip
    
    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
    }
    
    # Logging
    log {
        output stdout
        format console
    }
}